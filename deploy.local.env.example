# Copy this file to deploy.local.env (gitignored, never committed) and fill
# in real values. scripts/deploy.sh sources it automatically if present.
# Quote any value containing spaces or shell-special characters (e.g. a
# Windows key path with parentheses) -- this file is sourced by bash.

OFM_DEPLOY_HOST=user@your-server-ip
OFM_DEPLOY_DIR=/home/user/ofmhelper
OFM_DEPLOY_SSH_KEY=/path/to/private-key
