{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "PYDANTIC_DISABLE_PLUGINS=__all__ uv run --project \"$CLAUDE_PROJECT_DIR\" --frozen --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" --frozen --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_on_edit.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|Skill|Agent|Task|mcp__codegraph__codegraph_explore|WebSearch|WebFetch|Grep|TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "PYDANTIC_DISABLE_PLUGINS=__all__ uv run --project \"$CLAUDE_PROJECT_DIR\" --frozen --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "PYDANTIC_DISABLE_PLUGINS=__all__ uv run --project \"$CLAUDE_PROJECT_DIR\" --frozen --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYDANTIC_DISABLE_PLUGINS=__all__ uv run --project \"$CLAUDE_PROJECT_DIR\" --frozen --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYDANTIC_DISABLE_PLUGINS=__all__ uv run --project \"$CLAUDE_PROJECT_DIR\" --frozen --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYDANTIC_DISABLE_PLUGINS=__all__ uv run --project \"$CLAUDE_PROJECT_DIR\" --frozen --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYDANTIC_DISABLE_PLUGINS=__all__ uv run --project \"$CLAUDE_PROJECT_DIR\" --frozen --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYDANTIC_DISABLE_PLUGINS=__all__ uv run --project \"$CLAUDE_PROJECT_DIR\" --frozen --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
