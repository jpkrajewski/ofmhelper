.venv
__pycache__
**/__pycache__
*.pyc
.env
.env.bak*
.pytest_cache
.ruff_cache
*.egg-info
CLAUDE.local.md
deploy.local.env

# Runtime data directories, anchored to the repo root with a leading slash.
# Unanchored ("downloads"), git matches the name at ANY depth -- which
# silently ignored src/ofmhelpers/web/routers/downloads/__init__.py once the
# routers were grouped into packages. Keep these anchored.
/uploads/
/downloads/
/kieai_out/
/out/
/output/
/secrets/
/cookies/
backlog.txt

# Production database snapshot the migration tests run against: real
# customer data, local only -- this repo is public.
/tests/fixtures/prod_snapshot.sql

# Raw source media for the landing page. The web transcodes next to them
# (*-web.mp4) are what the page loads and what ships in the image; these
# originals are kept locally only -- results1.mp4 alone is 182MB, over
# GitHub's 100MB per-file limit.
/src/ofmhelpers/web/static/media/videos/results1.mp4
/src/ofmhelpers/web/static/media/videos/*.MOV

# Test reports (scripts/test.sh): local, regenerated every run.
/reports/

# Logfire project credential (write token), made by `logfire projects use`.
.logfire/

# Contains live API keys (ElevenLabs etc.) — local only, never commit.
/VOICEchanger.md

# Serena (code-navigation MCP) local project state.
/.serena/

# Local ops notes (server IP, domain setup): never in this public repo.
/ops.local/
